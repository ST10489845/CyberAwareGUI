<Window x:Class="CyberAware.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CyberAware - Cybersecurity Assistant" 
        Height="750" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#1a1a2e"
        MinHeight="600" MinWidth="900">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#0d1b2a"/>
            <Setter Property="Foreground" Value="#00b4d8"/>
            <Setter Property="BorderBrush" Value="#00b4d8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="FontSize" Value="12"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#00b4d8"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#16213e"/>
            <Setter Property="Foreground" Value="#eeeeee"/>
            <Setter Property="BorderBrush" Value="#00b4d8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="CaretBrush" Value="#00b4d8"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0" Background="#16213e" BorderBrush="#00b4d8" BorderThickness="0,0,2,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="15">
                    <!-- Logo -->
                    <Border Background="#00b4d8" CornerRadius="50" Width="90" Height="90" 
                            HorizontalAlignment="Center" Margin="0,20,0,10"
                            BorderBrush="White" BorderThickness="2">
                        <TextBlock Text="🛡️" FontSize="50" TextAlignment="Center" 
                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="CYBERAWARE" Foreground="#00b4d8" FontSize="20" FontWeight="Bold" 
                               HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    <TextBlock Text="Security Assistant" Foreground="#aaaaaa" FontSize="12" 
                               HorizontalAlignment="Center" Margin="0,5,0,20"/>

                    <!-- User Info -->
                    <Border Background="#0d1b2a" CornerRadius="10" Padding="10" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="👤 USER" Foreground="#aaaaaa" FontSize="10" FontWeight="Bold"/>
                            <TextBlock x:Name="UserNameDisplay" Text="Not set" Foreground="#ffd93d" 
                                       FontSize="14" FontWeight="Bold" Margin="0,5,0,0"/>
                            <TextBlock Text="🎯 INTEREST" Foreground="#aaaaaa" FontSize="10" 
                                       FontWeight="Bold" Margin="0,10,0,0"/>
                            <TextBlock x:Name="UserInterestDisplay" Text="None" Foreground="#00b4d8" 
                                       FontSize="12" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Sentiment Display -->
                    <Border Background="#0d1b2a" CornerRadius="10" Padding="10" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="😊 MOOD" Foreground="#aaaaaa" FontSize="10" FontWeight="Bold"/>
                            <TextBlock x:Name="SentimentDisplay" Text="Neutral" Foreground="#00f5a0" 
                                       FontSize="12" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Quick Topics -->
                    <TextBlock Text="📚 TOPICS" Foreground="#00b4d8" FontSize="12" FontWeight="Bold" Margin="0,0,0,10"/>

                    <Button Content="🔐 Password Security" Tag="password" Click="QuickTopic_Click"/>
                    <Button Content="🎣 Phishing Scams" Tag="phishing" Click="QuickTopic_Click"/>
                    <Button Content="🕵️ Online Privacy" Tag="privacy" Click="QuickTopic_Click"/>
                    <Button Content="🚨 Scam Prevention" Tag="scam" Click="QuickTopic_Click"/>
                    <Button Content="📱 SIM Swap" Tag="sim swap" Click="QuickTopic_Click"/>
                    <Button Content="🔒 2FA Setup" Tag="2fa" Click="QuickTopic_Click"/>
                    <Button Content="🌐 Safe Browsing" Tag="safe browsing" Click="QuickTopic_Click"/>

                    <!-- Divider -->
                    <Border Height="1" Background="#00b4d8" Margin="0,15,0,15" Opacity="0.3"/>

                    <!-- Task & Quiz Features -->
                    <TextBlock Text="⚡ FEATURES" Foreground="#00f5a0" FontSize="12" FontWeight="Bold" Margin="0,0,0,10"/>

                    <Button Content="📋 My Tasks" Tag="show tasks" Click="QuickTopic_Click"/>
                    <Button Content="📝 Start Quiz" Tag="start quiz" Click="QuickTopic_Click"/>
                    <Button Content="📋 Activity Log" Click="ActivityLog_Click" Background="#00b4d8" Foreground="White" FontWeight="Bold"/>

                    <!-- Divider -->
                    <Border Height="1" Background="#00b4d8" Margin="0,15,0,15" Opacity="0.3"/>

                    <Button Content="🗑 Clear Chat" Click="ClearChat_Click" Margin="0,5,0,5" Background="#ff6b6b" Foreground="White" FontWeight="Bold"/>
                    <Button Content="🔊 Voice Greeting" Click="VoiceGreeting_Click" Margin="0,5,0,0" Background="#00b4d8" Foreground="White" FontWeight="Bold"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- MAIN CHAT AREA -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- CLEAN HEADER DESIGN -->
            <Border Grid.Row="0" Background="#1a1a2e" BorderBrush="#00b4d8" BorderThickness="0,0,0,2">
                <StackPanel Margin="10">
                    <!-- Main Title Row -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Shield Icon -->
                        <Border Grid.Column="0" Background="#00b4d8" CornerRadius="10" Width="40" Height="40" Margin="5">
                            <TextBlock Text="🛡️" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Title -->
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <TextBlock Text="CYBERAWARE" FontSize="22" FontWeight="Bold" Foreground="#00b4d8" 
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Cybersecurity Awareness Assistant" FontSize="11" Foreground="#aaaaaa" 
                                       HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Lock Icon -->
                        <Border Grid.Column="2" Background="#00f5a0" CornerRadius="10" Width="40" Height="40" Margin="5">
                            <TextBlock Text="🔒" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <!-- Divider -->
                    <Border Height="1" Background="#00b4d8" Margin="10,5,10,5" Opacity="0.5"/>

                    <!-- Tagline -->
                    <TextBlock Text="◆  STAY SAFE ONLINE  ◆  PROTECT YOUR DATA  ◆" 
                               FontSize="12" Foreground="#00f5a0" 
                               HorizontalAlignment="Center" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>

            <!-- Chat Messages -->
            <ScrollViewer x:Name="ChatScrollViewer" Grid.Row="1" Background="#1a1a2e" Padding="15">
                <StackPanel x:Name="ChatMessagesPanel"/>
            </ScrollViewer>

            <!-- Typing Indicator -->
            <Border x:Name="TypingIndicator" Grid.Row="2" Background="#16213e" 
                    CornerRadius="10" Margin="15,5,15,5" Padding="10" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🛡️" Foreground="#00f5a0" FontSize="14"/>
                    <TextBlock Text="CyberAware is typing" Foreground="#aaaaaa" FontSize="12" Margin="5,0,0,0"/>
                    <TextBlock x:Name="TypingDots" Text="..." Foreground="#00f5a0" FontSize="12"/>
                </StackPanel>
            </Border>

            <!-- Input Area -->
            <Border Grid.Row="3" Background="#1a1a2e" BorderBrush="#16213e" BorderThickness="0,2,0,0" Padding="15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="UserInputBox" Grid.Column="0" KeyDown="UserInputBox_KeyDown"/>

                    <Button x:Name="SendButton" Grid.Column="1" Width="80" Height="40" Margin="10,0,0,0"
                            Background="#00b4d8" Foreground="White" BorderThickness="0"
                            FontWeight="Bold" FontSize="14" Cursor="Hand" Click="SendButton_Click">
                        <TextBlock Text="Send" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
